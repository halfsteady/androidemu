/target
**/*.rs.bk

# Test ROMs are not distributed with this repository. See core/tests/roms/README.md
core/tests/roms/*
!core/tests/roms/README.md

# Android
.gradle/
.kotlin/
local.properties
*.apk
*.aab
app/build/
build/
.idea/
.cxx/

# Generated Android native libraries
android/app/src/main/jniLibs/

.harness/

# Upload signing key and the file holding its password. Losing these means a
# Play upload-key reset, and leaking them lets someone else sign as this app.
*.jks
*.keystore
android/keystore.properties

# Python bytecode from the scripts in scripts/ and brand/tools/.
__pycache__/
*.pyc
